@unpublished{bo2026backward,
  title = {Backward Elicitation of Preferences in Strategy-proof Mechanisms},
  author = {Inácio Bó and Lawrence Choo and Chunyu Zhao},
  year = {2026},
  month = jan,
  note = {Working Paper (Presented at The Fourth Wuhan Cherry Blossom Workshop on Experimental Economics)},
  abstract = {We study whether changing preference-elicitation order affects behavior in strategy-proof matching mechanisms. In a laboratory school choice setting, we vary the matching rule (Serial Dictatorship vs. Random Serial Dictatorship) and the ranking procedure (standard vs. backward, eliciting least-preferred schools first). Backward elicitation yields mixed effects: it decreases truthfulness under Random Serial Dictatorship but increases it under Serial Dictatorship. Analysis of decision-making shows participants respond to both payoff differences and perceived school competitiveness, but backward elicitation does not significantly alter sensitivity to either factor.},
  selected = {true},
  type = {Working Paper}
}

