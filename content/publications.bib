@unpublished{bo2026backward,
  title = {Backward Elicitation of Preferences in Strategy-Proof Mechanisms},
  author = {Inácio Bó and Lawrence Choo and Chunyu Zhao},
  year = {2026},
  month = jan,
  pdf = {/papers/backward_elicitation.pdf},
  note = {Presented at The Fourth Wuhan Cherry Blossom Workshop on Experimental Economics},
  abstract = {We study whether changing preference-elicitation order affects behavior in strategy-proof matching mechanisms. In a laboratory school choice setting, we vary the matching rule (Serial Dictatorship vs. Random Serial Dictatorship) and the ranking procedure (standard vs. backward, eliciting least-preferred schools first). Backward elicitation yields mixed effects: it decreases truthfulness under Random Serial Dictatorship but increases it under Serial Dictatorship. Analysis of decision-making shows participants respond to both payoff differences and perceived school competitiveness, but backward elicitation does not significantly alter sensitivity to either factor.},
  selected = {true},
  type = {Working Paper}
}

@unpublished{bo2026switching,
  title = {Mitigating Inequality and Manipulation in Multi-Object Allocation},
  author = {Inácio Bó and Chunyu Zhao},
  year = {2026},
  month = oct,
  pdf = {/papers/switching_random_priority.pdf},
  note = {Presented at the Joint Economics Workshop between the University of Macau and the City University of Macau},
  abstract = {In multi-object assignment problems without monetary transfers—such as course allocation and task assignments—sequential mechanisms generate a tension between incentives and fairness. Allowing agents to select several objects in priority order is strategy-proof but can concentrate too much value to those who choose first. Distributing choices across rounds reduces this advantage, but predictable future turns create opportunities for manipulation. We introduce the Switching Random Priority mechanism (SRP), which randomly selects each successive picker among agents other than the previous picker. This prevents consecutive choices while making it risky to postpone selecting a desirable object. We show that, with at least three agents, SRP is weakly SD-strategy-proof and weakly SD-envy-free. Moreover, every realized allocation satisfies ordinal rank balance, a fairness property limiting the concentration of highly ranked objects that quota-based serial dictatorship does not generally satisfy. With two agents, SRP instead becomes SD-efficient but fails weak SD-strategy-proofness.},
  selected = {true},
  type = {Working Paper}
}

