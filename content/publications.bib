@unpublished{bo2026backward,
  title = {Backward Elicitation of Preferences in Strategy-Proof Mechanisms},
  author = {Inácio Bó and Lawrence Choo and Chunyu Zhao},
  year = {2026},
  month = jan,
  pdf = {/papers/backward_elicitation.pdf},
  note = {Presented at the Xiamen University International Workshop on Experimental Economics, and The Fourth Wuhan Cherry Blossom Workshop on Experimental Economics},
  abstract = {We study whether changing preference-elicitation order affects behavior in strategy-proof matching mechanisms. In a laboratory school choice setting, we vary the matching rule (Serial Dictatorship vs. Random Serial Dictatorship) and the ranking procedure (standard vs. backward, eliciting least-preferred schools first). Backward elicitation yields mixed effects: it decreases truthfulness under Random Serial Dictatorship but increases it under Serial Dictatorship. Analysis of decision-making shows participants respond to both payoff differences and perceived school competitiveness, but backward elicitation does not significantly alter sensitivity to either factor.},
  selected = {true},
  type = {Working Paper}
}

@unpublished{bo2026switching,
  title = {Switching Random Priority: A Draft Without Predictable Turns},
  author = {Inácio Bó and Chunyu Zhao},
  year = {2026},
  month = oct,
  pdf = {/papers/switching_random_priority.pdf},
  note = {Presented at the Inaugural Asia Conference of the Economic Science Society, and the Joint Economics Workshop between the University of Macau and the City University of Macau},
  abstract = {Course seats, work shifts, players in a league, and the contents of an estate are often divided by letting agents take turns choosing. Under a serial dictatorship, letting each agent pick all of her items at once protects truthful reporting but concentrates widely desired items in the hands of early pickers. Alternating turns, as in a draft, limits this advantage, but agents who know when they will pick again can gain by strategically postponing private favorites in order to secure contested items. We propose a minimal change to the draft: after each pick, the turn passes to an agent drawn uniformly at random from all agents except the one who just picked. With at least three agents, the resulting \textit{Switching Random Priority} mechanism is weakly SD-envy-free and satisfies weak SD-strategy-proofness, a standard incentive criterion in random assignment. Every realized allocation satisfies \emph{bounded rank concentration}, an ex-post limit on the concentration of highly ranked items, which drafts also satisfy and serial dictatorships can violate. In simulations with Harvard Business School course-allocation data, SRP restores most of the preference satisfaction lost to manipulation in the observed draft and outperforms random serial dictatorship both with and without quotas, at the cost of higher utility inequality than the draft.},
  selected = {true},
  type = {Working Paper}
}

